[
  {
    "id": "chat-general-001",
    "input": "帮我用三句话解释什么是本地 AI Agent",
    "expectedRoute": "chat",
    "notes": "普通解释型问题不应进入工具模式。"
  },
  {
    "id": "tool-url-001",
    "input": "总结这个网页：https://example.com",
    "expectedRoute": "agent",
    "expectedTools": [
      "fetch_url"
    ],
    "notes": "包含 URL 时必须优先抓取网页内容。"
  },
  {
    "id": "tool-math-001",
    "input": "1287 * 34 等于多少？",
    "expectedRoute": "agent",
    "expectedTools": [
      "calculator"
    ],
    "notes": "明确算式应走计算器工具。",
    "expectedExpression": "1287*34"
  },
  {
    "id": "tool-file-create-001",
    "input": "新建一个333.txt 在电脑桌面上，内容是9999",
    "expectedRoute": "agent",
    "expectedTools": [
      "write_file"
    ],
    "notes": "明确的本地文件创建请求应进入 Agent 工具链路。"
  },
  {
    "id": "rag-kb-001",
    "input": "根据选中的知识库总结这份文档的结论",
    "expectedRoute": "rag",
    "notes": "选中知识库时应走知识库问答链路。",
    "context": {
      "useRag": true
    }
  },
  {
    "id": "tool-url-bare-001",
    "input": "https://example.com",
    "expectedRoute": "agent",
    "expectedTools": [
      "fetch_url"
    ]
  },
  {
    "id": "tool-math-question-001",
    "input": "请帮我计算一下 (12+3)*2 等于多少？",
    "expectedRoute": "agent",
    "expectedTools": [
      "calculator"
    ],
    "expectedExpression": "(12+3)*2"
  },
  {
    "id": "rag-suppress-tools-001",
    "input": "总结这个网页 https://example.com",
    "context": {
      "useRag": true
    },
    "expectedRoute": "rag"
  },
  {
    "id": "chat-greeting-001",
    "input": "你好",
    "expectedRoute": "chat"
  },
  {
    "id": "agent-forced-001",
    "input": "你好",
    "context": {
      "forceAgent": true
    },
    "expectedRoute": "agent"
  }
